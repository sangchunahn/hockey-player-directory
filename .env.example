# .env.example — SAFE TO COMMIT. Names and placeholders only, never real values.
#
# Setup:  copy this file to .env.local, then fill in the real values from
#         Supabase → Settings → API. .env.local is gitignored (see .gitignore).
#         Vite reads env files at startup — restart the dev server after editing.
#
# Production (Vercel): these same names go in the Vercel dashboard under
#         Settings → Environment Variables. The VITE_/no-prefix rule below
#         applies there too. See docs/vercel-hobby-setup.md.
#
# Boundary rules this file encodes: docs/client-vs-server-inventory.md

# -----------------------------------------------------------------------------
# PUBLIC — the VITE_ prefix tells Vite to embed these in the browser bundle.
#
# Only put values here that are DESIGNED to be seen. Anyone can read them in
# DevTools. The anon key is safe to expose only because Row Level Security on
# the database decides what it can actually read (RLS lands in Sprint 4).
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# SECRET — server only. NO VITE_ prefix, ever.
#
# A VITE_ prefix on any name below would ship that value to every visitor's
# browser. The service role key bypasses Row Level Security entirely — it is a
# master key to the database. Treat it like the database password.
#
# Read these only through serverEnv in the typed config module; never from a
# route component or anything under src/components/.
# -----------------------------------------------------------------------------

# Same URL as VITE_SUPABASE_URL above — duplicated without the prefix so server
# code can read it without touching the client-exposed copy.
SUPABASE_URL=

# Supabase → Settings → API → Project API keys → service_role (click "Reveal").
# If this ever lands in a browser file, a commit, or a chat log: rotate it at
# Settings → API → Reset. Do not just delete the message.
SUPABASE_SERVICE_ROLE_KEY=
