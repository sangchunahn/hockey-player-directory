{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      // App-level config lives outside src/ (app/config/env.ts) to match the
      // sprint manifest. vite.config.ts has `resolve.tsconfigPaths`, so this
      // alias resolves at build time too.
      "#app/*": ["./app/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "node" types are needed for `process.env` in server-only modules
    // (src/config/env.ts). @types/node is already a devDependency.
    "types": ["vite/client", "node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
